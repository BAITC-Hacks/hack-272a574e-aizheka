# Nonsecret template. Agent.act currently runs offline regardless of these values.
# Experimental helpers load .env.local only when explicitly requested by a caller.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
BEELINE_AI_MODE=offline
BEELINE_MAX_API_COST_USD=0
BEELINE_JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
BEELINE_JEV_MODEL=typesafe-ai/jev
# Draft/escalation models remain unselected pending live validation.
BEELINE_DRAFT_MODEL=
BEELINE_ESCALATION_MODEL=
